# CaterHub website settings. Copy to ".env" (local) and add the same two
# variables in Vercel > Project > Settings > Environment Variables.
# Only PUBLIC values go here (publishable / anon key). Never put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
